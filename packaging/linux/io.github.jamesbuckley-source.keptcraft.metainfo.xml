<component type="desktop-application">
  <id>io.github.jamesbuckley-source.keptcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>KeptCraft</name>
  <summary>Capture, annotate, redact and share screenshots</summary>
  <developer id="io.github.jamesbuckley-source">
    <name>The KeptCraft contributors</name>
  </developer>
  <description>
    <p>
      KeptCraft captures an area, a window, the whole screen or a scrolling page,
      then lets you annotate, redact and share the result.
    </p>
    <ul>
      <li>Area, window, fullscreen, scrolling and self-timer captures over a frozen screen</li>
      <li>Arrows, shapes, text, counters, highlighter, spotlight, blur and pixelate</li>
      <li>Backgrounds with padding, rounded corners and shadows</li>
      <li>On-device text recognition and QR code reading</li>
      <li>Pinned screenshots, capture history and drag and drop into other apps</li>
      <li>Every capture mode is a command you can bind to a keyboard shortcut</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.jamesbuckley-source.keptcraft.desktop</launchable>
